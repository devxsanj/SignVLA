<mujoco model="RoArm-M2-Pro-Official">

    <compiler angle="radian" autolimits="true"/>

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="implicitfast"/>

    <visual>
        <headlight diffuse="0.8 0.8 0.8"
                    ambient="0.3 0.3 0.3"/>
        <global offwidth="1920"
                offheight="1080"/>
    </visual>

    <default>
        <joint damping="2"
               armature="0.02"
               limited="true"/>
        <position ctrllimited="true"/>
        <geom condim="3"
              friction="0.8 0.1 0.1"
              density="500"/>
    </default>

    <asset>

        <!-- ===================================================== -->
        <!-- OFFICIAL ROARM-M2-PRO MESHES — DO NOT CHANGE         -->
        <!-- ===================================================== -->

        <mesh name="base_link_mesh"
              file="meshes/base_link.stl"/>

        <mesh name="link1_mesh"
              file="meshes/link1.stl"/>

        <mesh name="link2_mesh"
              file="meshes/link2.stl"/>

        <mesh name="link3_mesh"
              file="meshes/link3.stl"/>

        <mesh name="gripper_mesh"
              file="meshes/gripper_link.stl"/>


        <!-- ===================================================== -->
        <!-- MATERIALS                                             -->
        <!-- ===================================================== -->

        <material name="silver"
                  rgba="0.68 0.70 0.73 1"/>

        <material name="dark"
                  rgba="0.12 0.13 0.15 1"/>

        <material name="floor_mat"
                  rgba="0.16 0.17 0.19 1"/>

        <material name="table_mat"
                  rgba="0.28 0.30 0.34 1"/>

        <material name="cube_mat"
                  rgba="0.10 0.55 0.95 1"/>

        <material name="target_mat"
                  rgba="0.20 0.80 0.45 0.55"/>

    </asset>


    <worldbody>

        <!-- ===================================================== -->
        <!-- LIGHT                                                 -->
        <!-- ===================================================== -->

        <light name="key_light"
               directional="true"
               pos="0 -1.5 2.5"
               dir="0 0 -1"
               diffuse="0.9 0.9 0.9"
               specular="0.3 0.3 0.3"/>


        <!-- ===================================================== -->
        <!-- FLOOR                                                 -->
        <!-- ===================================================== -->

        <geom name="floor"
              type="plane"
              size="2 2 0.05"
              pos="0 0 0"
              material="floor_mat"/>


        <!-- ===================================================== -->
        <!-- WORK TABLE                                            -->
        <!-- ===================================================== -->

        <body name="task_table"
              pos="0 0 0.20">

            <!-- Table top -->
            <geom name="table_top"
                  type="box"
                  size="0.60 0.50 0.035"
                  pos="0 0 0.035"
                  material="table_mat"
                  contype="1"
                  conaffinity="1"
                  friction="0.9 0.1 0.1"/>

            <!-- Legs -->
            <geom name="leg_fl"
                  type="box"
                  size="0.035 0.035 0.20"
                  pos="-0.52 -0.42 -0.165"
                  material="table_mat"/>

            <geom name="leg_fr"
                  type="box"
                  size="0.035 0.035 0.20"
                  pos="-0.52 0.42 -0.165"
                  material="table_mat"/>

            <geom name="leg_bl"
                  type="box"
                  size="0.035 0.035 0.20"
                  pos="0.52 -0.42 -0.165"
                  material="table_mat"/>

            <geom name="leg_br"
                  type="box"
                  size="0.035 0.035 0.20"
                  pos="0.52 0.42 -0.165"
                  material="table_mat"/>

        </body>


        <!-- ===================================================== -->
        <!-- LEFT DESTINATION                                      -->
        <!-- ===================================================== -->

        <geom name="left_target"
              type="box"
              size="0.075 0.075 0.003"
              pos="-0.28 -0.20 0.238"
              material="target_mat"
              contype="0"
              conaffinity="0"/>


        <!-- ===================================================== -->
        <!-- SMALL SIMPLE CUBE                                     -->
        <!-- ===================================================== -->

        <!-- Starts on the RIGHT side of the workspace -->

        <body name="task_cube"
              pos="0.28 -0.20 0.278">

            <freejoint name="task_cube_free"/>

            <geom name="task_cube_geom"
                  type="box"
                  size="0.025 0.025 0.025"
                  mass="0.05"
                  material="cube_mat"
                  condim="3"
                  friction="0.9 0.1 0.1"
                  contype="1"
                  conaffinity="1"/>

        </body>


        <!-- ===================================================== -->
        <!-- CAMERA                                                -->
        <!-- ===================================================== -->

        <camera name="task_camera"
                pos="1.35 -1.50 1.15"
                xyaxes="0.75 0.66 0.0 -0.28 0.32 0.90"
                fovy="55"/>


        <!-- ===================================================== -->
        <!-- OFFICIAL ROARM-M2-PRO                                 -->
        <!--                                                    -->
        <!-- IMPORTANT:                                             -->
        <!-- The internal mesh/joint structure is unchanged.      -->
        <!-- Only the ROOT POSITION is changed so the robot sits   -->
        <!-- on top of the table instead of below it.              -->
        <!-- ===================================================== -->

        <body name="base_link"
              pos="0 0 0.34">

            <inertial
                pos="0.0032 0 0.04"
                mass="0.2562183"
                fullinertia="0.00029211 0.00035719 0.000349421 0 0 0"/>

            <geom name="base_link_visual"
                  type="mesh"
                  mesh="base_link_mesh"
                  material="silver"
                  contype="1"
                  conaffinity="1"/>


            <!-- ================================================= -->
            <!-- LINK 1 / BASE ROTATION                            -->
            <!-- ================================================= -->

            <body name="link1"
                  pos="0.0100000008759151 0 0.123059270461044">

                <joint name="base_joint"
                       type="hinge"
                       axis="0 0 1"
                       range="-3.1416 3.1416"
                       damping="2"/>

                <inertial
                    pos="0 0 -0.015"
                    mass="0.0729177"
                    fullinertia="0.0000468465 0.0000332107 0.0000501023 0 0 0"/>

                <geom name="link1_visual"
                      type="mesh"
                      mesh="link1_mesh"
                      material="silver"
                      contype="1"
                      conaffinity="1"/>


                <!-- ============================================= -->
                <!-- LINK 2 / SHOULDER                            -->
                <!-- ============================================= -->

                <body name="link2"
                      pos="0 0 0"
                      euler="-1.5708 -1.5708 0">

                    <joint name="shoulder_joint"
                           type="hinge"
                           axis="0 0 1"
                           range="-1.5708 1.5708"
                           damping="2"/>

                    <inertial
                        pos="0.122 0 0"
                        mass="0.0703216"
                        fullinertia="0.0000546501 0.000423091 0.000404557 0 0 0"/>

                    <geom name="link2_visual"
                          type="mesh"
                          mesh="link2_mesh"
                          material="silver"
                          contype="1"
                          conaffinity="1"/>


                    <!-- ========================================= -->
                    <!-- LINK 3 / ELBOW                            -->
                    <!-- ========================================= -->

                    <body name="link3"
                          pos="0.236815132922094 0.0300023995170449 0"
                          euler="0 0 1.5708">

                        <joint name="elbow_joint"
                               type="hinge"
                               axis="0 0 1"
                               range="-1 2.95"
                               damping="2"/>

                        <inertial
                            pos="0.002 -0.13687 0.0059"
                            mass="0.0269773"
                            fullinertia="0.000199591 0.00000801674 0.000196918 0 0 0"/>

                        <geom name="link3_visual"
                              type="mesh"
                              mesh="link3_mesh"
                              material="silver"
                              contype="1"
                              conaffinity="1"/>


                        <!-- ===================================== -->
                        <!-- END EFFECTOR                          -->
                        <!-- ===================================== -->

                        <body name="gripper_link"
                              pos="0.002906 -0.21599 -0.00066683"
                              quat="-0.5 0.5 -0.5 0.5">

                            <joint name="eoat_joint"
                                   type="hinge"
                                   axis="0 0 1"
                                   range="0 1.5"
                                   damping="1.5"/>

                            <inertial
                                pos="0.029 0.0027 -0.00078"
                                mass="0.0028708"
                                fullinertia="0.000000523216 0.00000182071 0.00000160231 0 0 0"/>

                            <geom name="gripper_visual"
                                  type="mesh"
                                  mesh="gripper_mesh"
                                  material="silver"
                                  contype="1"
                                  conaffinity="1"/>

                        </body>

                    </body>

                </body>

            </body>

        </body>

    </worldbody>


    <!-- ========================================================= -->
    <!-- ACTUATORS                                                 -->
    <!-- ========================================================= -->

    <actuator>

        <position name="base_motor"
                  joint="base_joint"
                  kp="80"
                  kv="10"
                  ctrlrange="-3.1416 3.1416"/>

        <position name="shoulder_motor"
                  joint="shoulder_joint"
                  kp="100"
                  kv="12"
                  ctrlrange="-1.5708 1.5708"/>

        <position name="elbow_motor"
                  joint="elbow_joint"
                  kp="100"
                  kv="12"
                  ctrlrange="-1 2.95"/>

        <position name="eoat_motor"
                  joint="eoat_joint"
                  kp="70"
                  kv="8"
                  ctrlrange="0 1.5"/>

    </actuator>


    <!-- ========================================================= -->
    <!-- KEYFRAMES                                                 -->
    <!-- ========================================================= -->

    <keyframe>

        <!--
            HOME / REST

            Base     = 0°
            Shoulder = 0°
            Elbow    = 90°
            Gripper  = open
        -->

        <key name="home"
              qpos="0 0 1.5708 1.5"/>


        <!--
            SLEEP

            Used ONLY when quitting.
            Horizontal sleep position.
        -->

        <key name="sleep"
              qpos="0 0 0 0"/>

    </keyframe>

</mujoco>