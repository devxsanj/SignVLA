<mujoco model="RoArm-M2-Pro">

    <compiler angle="radian" autolimits="true"/>

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="implicitfast"/>

    <visual>
        <headlight
            diffuse="0.8 0.8 0.8"
            ambient="0.3 0.3 0.3"/>
        <global offwidth="1920" offheight="1080"/>
    </visual>

    <default>

        <joint
            damping="2"
            armature="0.02"
            limited="true"/>

        <position
            kp="100"
            kv="15"/>

        <geom
            condim="3"
            friction="0.8 0.1 0.1"
            density="500"/>

    </default>


    <worldbody>

        <!-- FLOOR -->

        <geom
            name="floor"
            type="plane"
            size="2 2 0.1"
            pos="0 0 0"
            rgba="0.15 0.15 0.15 1"/>


        <!-- BASE -->

        <body
            name="base"
            pos="0 0 0.12">

            <geom
                name="base_visual"
                type="cylinder"
                size="0.11 0.12"
                rgba="0.25 0.25 0.28 1"/>

            <joint
                name="base_joint"
                type="hinge"
                axis="0 0 1"
                range="-3.14159 3.14159"/>


            <!-- SHOULDER -->

            <body
                name="shoulder"
                pos="0 0 0.12">

                <geom
                    name="shoulder_visual"
                    type="box"
                    size="0.075 0.075 0.20"
                    pos="0 0 0.20"
                    rgba="0.30 0.30 0.32 1"/>

                <joint
                    name="shoulder_joint"
                    type="hinge"
                    axis="0 1 0"
                    pos="0 0 0.30"
                    range="-1.57 1.57"/>


                <!-- UPPER ARM -->

                <body
                    name="upper_arm"
                    pos="0 0 0.30">

                    <geom
                        name="upper_arm_visual"
                        type="capsule"
                        fromto="0 0 0 0 0 0.32"
                        size="0.055"
                        rgba="0.65 0.65 0.68 1"/>


                    <!-- ELBOW -->

                    <body
                        name="elbow"
                        pos="0 0 0.32">

                        <joint
                            name="elbow_joint"
                            type="hinge"
                            axis="0 1 0"
                            range="-1.57 1.57"/>


                        <!-- FOREARM -->

                        <body
                            name="forearm"
                            pos="0 0 0">

                            <geom
                                name="forearm_visual"
                                type="capsule"
                                fromto="0 0 0 0 0 0.28"
                                size="0.045"
                                rgba="0.70 0.70 0.73 1"/>


                            <!-- EOAT -->

                            <body
                                name="end_effector"
                                pos="0 0 0.28">

                                <joint
                                    name="eoat_joint"
                                    type="hinge"
                                    axis="0 1 0"
                                    range="-1.57 1.57"/>

                                <geom
                                    name="wrist"
                                    type="cylinder"
                                    size="0.055 0.05"
                                    rgba="0.20 0.20 0.22 1"/>


                                <!-- GRIPPER MOUNT -->

                                <geom
                                    name="gripper_mount"
                                    type="box"
                                    size="0.075 0.055 0.025"
                                    pos="0 0 0.06"
                                    rgba="0.25 0.25 0.27 1"/>


                                <!-- LEFT FINGER -->

                                <body
                                    name="left_finger"
                                    pos="0.055 0 0.07">

                                    <joint
                                        name="left_finger_joint"
                                        type="hinge"
                                        axis="0 1 0"
                                        range="-0.55 0.55"/>

                                    <geom
                                        name="left_finger_geom"
                                        type="box"
                                        size="0.018 0.035 0.075"
                                        pos="0 0 0.075"
                                        rgba="0.85 0.85 0.87 1"/>

                                </body>


                                <!-- RIGHT FINGER -->

                                <body
                                    name="right_finger"
                                    pos="-0.055 0 0.07">

                                    <joint
                                        name="right_finger_joint"
                                        type="hinge"
                                        axis="0 1 0"
                                        range="-0.55 0.55"/>

                                    <geom
                                        name="right_finger_geom"
                                        type="box"
                                        size="0.018 0.035 0.075"
                                        pos="0 0 0.075"
                                        rgba="0.85 0.85 0.87 1"/>

                                </body>

                            </body>

                        </body>

                    </body>

                </body>

            </body>

        </body>


        <!-- OBJECT TO PICK -->

        <body
            name="object"
            pos="0 0 0.035">

            <freejoint/>

            <geom
                name="object_geom"
                type="box"
                size="0.035 0.035 0.035"
                rgba="0.85 0.20 0.10 1"
                friction="1.2 0.1 0.1"/>

        </body>

    </worldbody>


    <!-- ACTUATORS -->

    <actuator>

        <position
            name="base_motor"
            joint="base_joint"
            kp="100"
            kv="15"
            ctrlrange="-3.14159 3.14159"/>

        <position
            name="shoulder_motor"
            joint="shoulder_joint"
            kp="120"
            kv="18"
            ctrlrange="-1.57 1.57"/>

        <position
            name="elbow_motor"
            joint="elbow_joint"
            kp="120"
            kv="18"
            ctrlrange="-1.57 1.57"/>

        <position
            name="eoat_motor"
            joint="eoat_joint"
            kp="100"
            kv="15"
            ctrlrange="-1.57 1.57"/>


        <!-- GRIPPER -->

        <position
            name="left_gripper_motor"
            joint="left_finger_joint"
            kp="80"
            kv="10"
            ctrlrange="-0.55 0.55"/>

        <position
            name="right_gripper_motor"
            joint="right_finger_joint"
            kp="80"
            kv="10"
            ctrlrange="-0.55 0.55"/>

    </actuator>


    <!-- KEYFRAMES -->

    <keyframe>

        <key
            name="home"
            qpos="0 0 0 0 0.45 -0.45 0 0 0"/>

    </keyframe>

</mujoco>
