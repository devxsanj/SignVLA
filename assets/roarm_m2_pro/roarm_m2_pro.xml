<mujoco model="RoArm-M2-Pro-Official">

    <compiler angle="radian" autolimits="true"/>

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="implicitfast"/>

    <visual>
        <headlight
            diffuse="0.8 0.8 0.8"
            ambient="0.3 0.3 0.3"/>
        <global
            offwidth="1920"
            offheight="1080"/>
    </visual>

    <default>

        <joint
            damping="2"
            armature="0.02"
            limited="true"/>

        <position
            ctrllimited="true"/>

        <geom
            condim="3"
            friction="0.8 0.1 0.1"
            density="500"/>

    </default>


    <!-- ================================================= -->
    <!-- ASSETS -->
    <!-- ================================================= -->

    <asset>

        <mesh
            name="base_link_mesh"
            file="meshes/base_link.stl"/>

        <mesh
            name="link1_mesh"
            file="meshes/link1.stl"/>

        <mesh
            name="link2_mesh"
            file="meshes/link2.stl"/>

        <mesh
            name="link3_mesh"
            file="meshes/link3.stl"/>

        <mesh
            name="gripper_mesh"
            file="meshes/gripper_link.stl"/>


        <material
            name="silver"
            rgba="0.68 0.70 0.73 1"/>

        <material
            name="dark"
            rgba="0.12 0.13 0.15 1"/>

        <material
            name="floor_mat"
            rgba="0.16 0.17 0.19 1"/>

    </asset>


    <!-- ================================================= -->
    <!-- WORLD -->
    <!-- ================================================= -->

    <worldbody>

        <!-- Ground -->

        <geom
            name="floor"
            type="plane"
            size="2 2 0.05"
            pos="0 0 0"
            material="floor_mat"/>


        <!-- ================================================= -->
        <!-- BASE LINK -->
        <!-- ================================================= -->

        <body
            name="base_link"
            pos="0 0 0">

            <inertial
                pos="0.0032 0 0.04"
                mass="0.2562183"
                fullinertia="0.00029211 0.00035719 0.000349421 0 0 0"/>

            <geom
                name="base_link_visual"
                type="mesh"
                mesh="base_link_mesh"
                material="silver"
                contype="1"
                conaffinity="1"/>


            <!-- ================================================= -->
            <!-- J1 BASE -->
            <!-- ================================================= -->

            <body
                name="link1"
                pos="0.0100000008759151 0 0.123059270461044">

                <joint
                    name="base_joint"
                    type="hinge"
                    axis="0 0 1"
                    range="-3.1416 3.1416"
                    damping="2"/>

                <inertial
                    pos="0 0 -0.015"
                    mass="0.0729177"
                    fullinertia="0.0000468465 0.0000332107 0.0000501023 0 0 0"/>

                <geom
                    name="link1_visual"
                    type="mesh"
                    mesh="link1_mesh"
                    material="silver"
                    contype="1"
                    conaffinity="1"/>


                <!-- ================================================= -->
                <!-- J2 SHOULDER -->
                <!-- ================================================= -->

                <body
                    name="link2"
                    pos="0 0 0"
                    euler="-1.5708 -1.5708 0">

                    <joint
                        name="shoulder_joint"
                        type="hinge"
                        axis="0 0 1"
                        range="-1.5708 1.5708"
                        damping="2"/>

                    <inertial
                        pos="0.122 0 0"
                        mass="0.0703216"
                        fullinertia="0.0000546501 0.000423091 0.000404557 0 0 0"/>

                    <geom
                        name="link2_visual"
                        type="mesh"
                        mesh="link2_mesh"
                        material="silver"
                        contype="1"
                        conaffinity="1"/>


                    <!-- ================================================= -->
                    <!-- J3 ELBOW -->
                    <!-- ================================================= -->

                    <body
                        name="link3"
                        pos="0.236815132922094 0.0300023995170449 0"
                        euler="0 0 1.5708">

                        <joint
                            name="elbow_joint"
                            type="hinge"
                            axis="0 0 1"
                            range="-1 2.95"
                            damping="2"/>

                        <inertial
                            pos="0.002 -0.13687 0.0059"
                            mass="0.0269773"
                            fullinertia="0.000199591 0.00000801674 0.000196918 0 0 0"/>

                        <geom
                            name="link3_visual"
                            type="mesh"
                            mesh="link3_mesh"
                            material="silver"
                            contype="1"
                            conaffinity="1"/>


                        <!-- ================================================= -->
                        <!-- J4 EoAT -->
                        <!-- ================================================= -->

                        <body
                            name="gripper_link"
                            pos="0.002906 -0.21599 -0.00066683"
                            quat="-0.5 0.5 -0.5 0.5">

                            <joint
                                name="eoat_joint"
                                type="hinge"
                                axis="0 0 1"
                                range="0 1.5"
                                damping="1.5"/>

                            <inertial
                                pos="0.029 0.0027 -0.00078"
                                mass="0.0028708"
                                fullinertia="0.000000523216 0.00000182071 0.00000160231 0 0 0"/>

                            <geom
                                name="gripper_visual"
                                type="mesh"
                                mesh="gripper_mesh"
                                material="silver"
                                contype="1"
                                conaffinity="1"/>

                        </body>

                    </body>

                </body>

            </body>

        </body>

    </worldbody>


    <!-- ================================================= -->
    <!-- ACTUATORS -->
    <!-- ================================================= -->

    <actuator>

        <position
            name="base_motor"
            joint="base_joint"
            kp="80"
            kv="10"
            ctrlrange="-3.1416 3.1416"/>

        <position
            name="shoulder_motor"
            joint="shoulder_joint"
            kp="100"
            kv="12"
            ctrlrange="-1.5708 1.5708"/>

        <position
            name="elbow_motor"
            joint="elbow_joint"
            kp="100"
            kv="12"
            ctrlrange="-1 2.95"/>

        <position
            name="eoat_motor"
            joint="eoat_joint"
            kp="70"
            kv="8"
            ctrlrange="0 1.5"/>

    </actuator>


    <!-- ================================================= -->
    <!-- KEYFRAMES -->
    <!-- ================================================= -->

    <keyframe>

        <key
            name="home"
            qpos="0 0 0 0"/>

        <key
            name="pick"
            qpos="0 -0.7 1.4 0.5"/>

        <key
            name="place"
            qpos="0.65 -0.40 0.65 0.50"/>

    </keyframe>

</mujoco>
