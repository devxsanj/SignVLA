            ),
            0.60
        ),

        (
            np.array(
                [0.35, -0.50, 1.40, 0.00]
            ),
            0.30
        ),

        (
            np.array(
                [-0.35, -0.50, 1.00, 0.00]
            ),
            0.30
        ),

        (
            np.array(
                [0.35, -0.50, 1.40, 0.00]
            ),
            0.30
        ),

        (
            np.array(
                [-0.35, -0.50, 1.00, 0.00]
            ),
            0.30
        ),

        (
            HOME_POSE,
            0.60
        )
    ],


    # --------------------------------------------------------
    # YES
    # --------------------------------------------------------

    "nod_head": [

        (
            np.array(
