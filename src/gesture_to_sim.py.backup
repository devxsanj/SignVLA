"""
SignVLA
14-Class ISL Gesture -> RoArm-M2 Pro MuJoCo Controller

Pipeline:

MediaPipe
    ↓
30-frame landmark sequence
    ↓
trained Bi-GRU model
    ↓
14 ISL gestures
    ↓
gesture action map
    ↓
RoArm-M2 Pro simulation
"""

import os
import sys
import time
import math
import socket
import subprocess
from pathlib import Path

import numpy as np
import mujoco
import mujoco.viewer


# ============================================================
# PROJECT / VENV
# ============================================================

PROJECT_ROOT = Path(__file__).resolve().parent.parent

VENV_PY = PROJECT_ROOT / ".venv" / "bin" / "python"

if not VENV_PY.exists():
    VENV_PY = PROJECT_ROOT / "venv" / "bin" / "python"


if VENV_PY.exists() and sys.prefix == sys.base_prefix:
    os.execv(
        str(VENV_PY),
        [str(VENV_PY)] + sys.argv
    )


# ============================================================
# IMPORT CONFIG
# ============================================================

sys.path.append(str(PROJECT_ROOT))

import config


# ============================================================
# UDP
# ============================================================

UDP_IP = "127.0.0.1"
UDP_PORT = 9876


# ============================================================
# ROARM-M2 PRO
# ============================================================

XML_PATH = config.ROARM_MODEL_XML

if not XML_PATH.exists():
    print("[ERROR] RoArm model not found:")
    print(XML_PATH)
    raise SystemExit(1)


# ============================================================
# LOAD MUJOCO
# ============================================================

model = mujoco.MjModel.from_xml_path(
    str(XML_PATH)
)

data = mujoco.MjData(model)


print()
print("=" * 65)
print("        SignVLA — 14-Class ISL RoArm Controller")
print("=" * 65)
print()
print("Model:", XML_PATH)
print("Joints:", model.njnt)
print("Actuators:", model.nu)
print()


for i in range(model.nu):
    print(
        f"Actuator {i}: "
        f"{model.actuator(i).name} "
        f"range={model.actuator_ctrlrange[i]}"
    )


print()


# ============================================================
# VERIFY EXPECTED 4-DOF MODEL
# ============================================================

if model.nu != 4:

    print(
        "[ERROR] Expected 4 RoArm actuators "
        f"but found {model.nu}."
    )

    raise SystemExit(1)


# ============================================================
# POSES
# ============================================================

HOME_POSE = np.array(
    [0.00, 0.00, 0.00, 0.00],
    dtype=np.float64
)


# Existing task poses from your working setup.

PICK_POSE = np.array(
    [0.00, -1.15, 1.65, 0.85],
    dtype=np.float64
)


PLACE_POSE = np.array(
    [0.75, -0.95, 1.35, 1.15],
    dtype=np.float64
)


# ============================================================
# SAFE CLAMP
# ============================================================

def clamp_pose(pose):

    pose = np.asarray(
        pose,
        dtype=np.float64
    ).copy()

    for i in range(4):

        pose[i] = np.clip(
            pose[i],
            model.actuator_ctrlrange[i][0],
            model.actuator_ctrlrange[i][1]
        )

    return pose


HOME_POSE = clamp_pose(HOME_POSE)
PICK_POSE = clamp_pose(PICK_POSE)
PLACE_POSE = clamp_pose(PLACE_POSE)


# ============================================================
# TRAJECTORIES
# ============================================================

