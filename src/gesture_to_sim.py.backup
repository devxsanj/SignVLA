# ============================================================
# TRAJECTORY PLAYER
# ============================================================

class TrajectoryPlayer:

    def __init__(self):

        self.current_ctrl = HOME_POSE.copy()

        self.waypoints = []

        self.index = 0

        self.start_pose = HOME_POSE.copy()

        self.start_time = 0.0

        self.active = False

        self.action = "IDLE"


    def play(self, action):

        if action not in ACTION_TRAJECTORIES:

            print(
                "[WARNING] No trajectory for:",
                action
            )

            return


        self.waypoints = [

            (
                clamp_pose(target),
                duration
            )

            for target, duration
            in ACTION_TRAJECTORIES[action]
        ]


        self.index = 0

        self.start_pose = (
            self.current_ctrl.copy()
        )

        self.start_time = time.time()

        self.active = True

        self.action = action

        print(
            f"\n[ROBOT] "
            f"{action.upper()}"
        )


    def update(self):

        if not self.active:

            return self.current_ctrl


        target, duration = (
            self.waypoints[self.index]
        )


        elapsed = (
            time.time()
            - self.start_time
        )


        alpha = min(
            elapsed / max(duration, 0.001),
            1.0
        )


        # Cosine interpolation.

        smooth = (
            0.5
            * (
                1.0
                - math.cos(
                    math.pi * alpha
                )
            )
        )


        self.current_ctrl = (
            (1.0 - smooth)
            * self.start_pose
            +
            smooth
            * target
        )


        if alpha >= 1.0:

            self.index += 1


            if self.index < len(
                self.waypoints
            ):

                self.start_pose = (
                    self.current_ctrl.copy()
                )

                self.start_time = (
                    time.time()
                )

            else:

                self.active = False

                self.action = "IDLE"


        return self.current_ctrl


# ============================================================
# UDP BRIDGE
# ============================================================

def run():

    sock = socket.socket(
        socket.AF_INET,
        socket.SOCK_DGRAM
    )

    sock.bind(
        (
            UDP_IP,
            UDP_PORT
        )
    )

    sock.setblocking(False)


    # --------------------------------------------------------
    # Start trained-model vision process
    # --------------------------------------------------------

    tracker = (
        PROJECT_ROOT
        / "src"
        / "vision_tracker.py"
    )


    print(
        "[LAUNCH] Starting "
        "14-class MediaPipe + GRU tracker..."
    )


    tracker_proc = subprocess.Popen(
        [
            str(VENV_PY),
            str(tracker)
        ]
    )


    # --------------------------------------------------------
    # Robot
    # --------------------------------------------------------

    player = TrajectoryPlayer()

    data.ctrl[:] = HOME_POSE


    print()
    print("=" * 65)
    print("  14-CLASS ISL → RoArm-M2 Pro")
    print("=" * 65)
    print()


    for gesture in config.GESTURES:

        action = (
            config.GESTURE_ACTION_MAP
            .get(gesture)
        )

        print(
            f"{gesture:<8} -> "
            f"{action}"
        )


    print()
    print(
        "Camera tracker uses:"
    )
    print(
        "MediaPipe → 30×126 → GRU"
    )
    print()


    try:

        with mujoco.viewer.launch_passive(
            model,
            data
        ) as viewer:

            while viewer.is_running():

                # ------------------------------------------------
                # Tracker status
                # ------------------------------------------------

                if (
                    tracker_proc.poll()
                    is not None
                ):

                    print(
                        "\n[INFO] "
                        "Vision tracker stopped."
                    )

                    break


                # ------------------------------------------------
                # Receive gesture action
                # ------------------------------------------------

                try:

                    packet, _ = (
                        sock.recvfrom(1024)
                    )

                    message = (
                        packet
                        .decode(
                            "utf-8"
                        )
                        .strip()
                    )


                    if message == "QUIT":

                        break


                    if (
                        message
                        in ACTION_TRAJECTORIES
                    ):

                        if not player.active:

                            player.play(
                                message
                            )


                except BlockingIOError:

                    pass


                # ------------------------------------------------
                # Update robot
                # ------------------------------------------------

                ctrl = player.update()

                data.ctrl[:] = ctrl


                # ------------------------------------------------
                # Physics
                # ------------------------------------------------

                for _ in range(4):

                    mujoco.mj_step(
                        model,
                        data
                    )


                viewer.sync()

                time.sleep(
                    0.005
                )


    finally:

        print(
            "\n[SHUTDOWN] "
            "Stopping SignVLA..."
        )


        sock.close()


        if tracker_proc.poll() is None:

            tracker_proc.terminate()

            try:

                tracker_proc.wait(
                    timeout=2
                )

            except subprocess.TimeoutExpired:

                tracker_proc.kill()


        print(
            "[DONE]"
        )


# ============================================================
# ENTRY
# ============================================================

if __name__ == "__main__":

    run()
